# ==============================================================================
# AmazeCC Backend API Environment Variables (.env.example)
# ==============================================================================

# --- Database ---
# Supabase PostgreSQL connection string with PgBouncer transaction pooling (port 6543)
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Transaction pooler
DATABASE_URL=postgresql://postgres.REPLACE_ME:REPLACE_ME@aws-0-REPLACE_ME.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase direct/session mode PostgreSQL connection string (port 5432) for running DDL migrations
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> Session mode
DATABASE_URL_UNPOOLED=postgresql://postgres.REPLACE_ME:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres

# Serverless connection pool limit to prevent exhausting database pooler connections (default 5)
PG_POOL_MAX=5

# VERIFY: possibly unused (Vercel Postgres connection URL fallback if DATABASE_URL is unset)
POSTGRES_URL=REPLACE_ME

# VERIFY: possibly unused (Vercel Prisma connection URL fallback if DATABASE_URL is unset)
POSTGRES_PRISMA_URL=REPLACE_ME

# --- Auth and secrets ---
# HMAC-SHA256 secret for signing admin and club JWTs (generate with `openssl rand -hex 32`)
ADMIN_SECRET=REPLACE_ME

# Salt for hashing student registration numbers and IP addresses in audit logs (generate with `openssl rand -hex 32`)
ID_SALT=REPLACE_ME

# Dedicated secret for peer timetable sharing grants; MUST differ from ADMIN_SECRET and ID_SALT (generate with `openssl rand -hex 32`)
SOCIAL_GRANT_SECRET_KEY=REPLACE_ME

# Comma-separated list of VTOP registration numbers granted superadmin privileges (e.g. 21BCE0001,21BCE0002)
ADMIN_VTOP_IDS=REPLACE_ME

# --- Reviews ---
# Base URL of the faculty reviews Cloudflare Worker (default http://localhost:8787 for local dev)
REVIEWS_WORKER_URL=http://localhost:8787

# Shared HMAC secret for authenticating requests to Worker /internal/ingest; must match Worker (generate with `openssl rand -hex 32`)
REVIEWS_INGEST_SECRET=REPLACE_ME

# Dedicated secret for hashing student registration numbers for reviews; must differ from ID_SALT, ADMIN_SECRET, REVIEWS_INGEST_SECRET (generate with `openssl rand -hex 32`)
REVIEW_HASH_SECRET=REPLACE_ME

# Master feature flag to enable first-party faculty reviews routes and processing (default off)
ENABLE_AMAZE_REVIEWS=false

# --- Feature flags ---
# Killswitch for legacy vitfac review integration fallback (default true)
ENABLE_VITFAC_INTEGRATION=true

# --- Web Push Notifications ---
# Web push VAPID public key (generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REPLACE_ME

# Web push VAPID private key (generate with `npx web-push generate-vapid-keys`)
VAPID_PRIVATE_KEY=REPLACE_ME

# --- Upstream VTOP and Server Config ---
# Upstream VTOP base URL (defaults to VIT Chennai: https://vtopcc.vit.ac.in)
VTOP_BASE_URL=https://vtopcc.vit.ac.in

# Local HTTP server port (default 3000)
PORT=3000

# Base API URL used for internal loopback calls during admin authentication
NEXT_PUBLIC_API_URL=http://localhost:3000
