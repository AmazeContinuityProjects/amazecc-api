# ==============================================================================
# AmazeCC Backend API Environment Variables (.env.example)
#
# Copy this file to `.env` for local development.
# In production, provision these variables via deployment secrets management.
#
# Secret Generation Command:
#   openssl rand -hex 32
#
# Rules:
# - NEVER commit real production secrets to git.
# - Keep all feature flags defaulted to false/off until official release rollout.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Supabase PostgreSQL connection string with PgBouncer transaction pooling (port 6543)
# Format: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres.REPLACE_ME:REPLACE_ME@aws-0-REPLACE_ME.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase direct/session mode PostgreSQL connection string (port 5432) for running DDL migrations
DATABASE_URL_UNPOOLED=postgresql://postgres.REPLACE_ME:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres

# Serverless connection pool limit to prevent exhausting database pooler connections (default 5)
PG_POOL_MAX=5

# ------------------------------------------------------------------------------
# 2. First-Party Faculty Reviews Configuration (Milestone M3 / Feature 17 & 18)
# ------------------------------------------------------------------------------
# Master feature flag to enable first-party faculty reviews routes and processing
# MUST default to false for dark-launch safety.
ENABLE_AMAZE_REVIEWS=false

# Base URL of the faculty reviews Cloudflare Worker
# Local Dev: http://localhost:8787
# Staging: https://reviews-api-staging.amazecc.com
# Production: https://reviews-api.amazecc.com
REVIEWS_WORKER_URL=http://localhost:8787

# Shared HMAC-SHA256 secret for authenticating review ingestion requests to Worker (/internal/ingest)
# CRITICAL: Must be identical to REVIEWS_INGEST_SECRET in the Cloudflare Worker!
# Generate with: openssl rand -hex 32
REVIEWS_INGEST_SECRET=REPLACE_ME

# Dedicated salt/secret for one-way SHA-256 hashing of student registration numbers
# MUST differ from ID_SALT, ADMIN_SECRET, and REVIEWS_INGEST_SECRET!
# CRITICAL: DO NOT rotate mid-semester as it breaks student review deduplication and 14-day edit window.
# Generate with: openssl rand -hex 32
REVIEW_HASH_SECRET=REPLACE_ME

# Killswitch for legacy vitfac review integration fallback (default true)
ENABLE_VITFAC_INTEGRATION=true

# ------------------------------------------------------------------------------
# 3. Authentication & Security Secrets
# ------------------------------------------------------------------------------
# HMAC-SHA256 secret for signing admin and club session JWTs
# Generate with: openssl rand -hex 32
ADMIN_SECRET=REPLACE_ME

# Salt for hashing student registration numbers and IP addresses in general server audit logs
# Generate with: openssl rand -hex 32
ID_SALT=REPLACE_ME

# Dedicated secret for peer timetable sharing grants; MUST differ from ADMIN_SECRET and ID_SALT
# Generate with: openssl rand -hex 32
SOCIAL_GRANT_SECRET_KEY=REPLACE_ME

# Comma-separated list of VTOP registration numbers granted superadmin privileges
ADMIN_VTOP_IDS=REPLACE_ME

# ------------------------------------------------------------------------------
# 4. Web Push Notifications
# ------------------------------------------------------------------------------
# Web push VAPID public key (generate with `npx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REPLACE_ME

# Web push VAPID private key (generate with `npx web-push generate-vapid-keys`)
VAPID_PRIVATE_KEY=REPLACE_ME

# ------------------------------------------------------------------------------
# 5. Upstream VTOP and Server Config
# ------------------------------------------------------------------------------
# Upstream VTOP base URL (defaults to VIT Chennai: https://vtopcc.vit.ac.in)
VTOP_BASE_URL=https://vtopcc.vit.ac.in

# Local HTTP server port (default 3000)
PORT=3000

# Base API URL used for internal loopback calls during admin authentication
NEXT_PUBLIC_API_URL=http://localhost:3000
