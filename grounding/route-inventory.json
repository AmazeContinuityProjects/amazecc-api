    "returns": "{success,contact,…identity (buildIdentity)} / {error}",
    "rl": "-",
    "notes": "Scrapes ~10 VTOP profile endpoints sequentially (deliberately — avoids VTOP rate issues). Used by the app on every cold start (cache_whoami).",
    "cat": "academics"
  },
  {
