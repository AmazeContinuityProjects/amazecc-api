  {
    "path": "/api/login",
    "methods": [
      "POST"
    ],
    "auth": "none",
    "body": [
      "username",
      "password"
    ],
    "returns": "{success,message,cookies,csrf,authorizedID,clubToken?,clubRoles?} / {success:false,message|error}",
    "rl": "5/min/IP",
